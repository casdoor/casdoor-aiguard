{
  "displayName": "CodeBuddy on macOS",
  "description": "Everything CodeBuddy does on macOS while you code, decided by one policy. Only CodeBuddy's endpoints count as model endpoints, so a prompt containing your code cannot end up at a provider you never chose. Local MCP servers may read, edit and commit your working tree, while pushes, deletions and shell execution stop and wait for you. AppleScript, launchd and the keychain stay off limits, and so do secrets, cloud metadata, paste and tunnelling sites, and every payment.",
  "icon": "🍎",
  "author": "Casdoor",
  "strictness": "moderate",
  "agent": "CodeBuddy",
  "os": "macOS",
  "tags": [
    "coding",
    "llm-egress",
    "mcp-tools",
    "homebrew"
  ],
  "model": [
    "[request_definition]",
    "r = sub, obj, act",
    "",
    "[policy_definition]",
    "p = sub, obj, act, eft",
    "",
    "[policy_effect]",
    "e = some(where (p_eft == allow)) && !some(where (p_eft == deny))",
    "",
    "[matchers]",
    "m = r.sub == p.sub && regexMatch(r.obj, p.obj) && regexMatch(r.act, p.act)"
  ],
  "policy": [
    "# aiguard evaluates one triple per intercepted call:",
    "#   sub = the recognized agent, obj = the destination host (\"host#tool\" for",
    "#   an MCP tools/call), act = the intent category the recognizer produced.",
    "",
    "# 1. The model endpoints CodeBuddy is allowed to talk to.",
    "p, codebuddy, ^(.+\\.)?codebuddy\\.ai$, llm\\.chat, allow",
    "p, codebuddy, ^(.+\\.)?tencentcloudapi\\.com$, llm\\.chat, allow",
    "",
    "# 2. Documentation MCP servers it may query over the network.",
    "p, codebuddy, ^(mcp\\.context7\\.com|mcp\\.deepwiki\\.com)#.*$, mcp\\.tool_call, allow",
    "",
    "# 3. Local MCP servers: it may read, edit and commit the workspace you opened.",
    "p, codebuddy, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(read_file|read_text_file|read_multiple_files|list_directory|directory_tree|search_files|get_file_info|grep_search)$, mcp\\.tool_call, allow",
    "p, codebuddy, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(write_file|edit_file|create_file|apply_patch|create_directory|move_file)$, mcp\\.tool_call, allow",
    "p, codebuddy, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#git_(status|diff|log|show|branch|blame)$, mcp\\.tool_call, allow",
    "p, codebuddy, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#git_(add|commit|checkout|stash)$, mcp\\.tool_call, allow",
    "p, codebuddy, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(run_tests|build_project|lint_project|format_file)$, mcp\\.tool_call, allow",
    "",
    "# 4. Read-only homebrew queries are part of debugging a build.",
    "p, codebuddy, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(brew_search|brew_info|brew_list|system_profiler)$, mcp\\.tool_call, allow",
    "",
    "# 5. Changing the machine itself is not coding: AppleScript, launchd and the keychain.",
    "p, codebuddy, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(applescript_execute|osascript_run|launchctl_load|keychain_read|defaults_write|brew_install|brew_uninstall)$, mcp\\.tool_call, deny",
    "p, codebuddy, .*#(execute_command|run_command|run_shell|start_process|kill_process|create_process)$, mcp\\.tool_call, deny",
    "",
    "# 6. Destructive or outward-facing repository operations need a human.",
    "p, codebuddy, .*#(delete_file|remove_directory|delete_directory|git_push|git_reset_hard|git_clean|git_force_push)$, mcp\\.tool_call, deny",
    "",
    "# 7. Secrets, cloud metadata and the usual exfiltration channels.",
    "p, codebuddy, .*#.*(secret|credential|token|password|api_key|keychain|env_file).*$, mcp\\.tool_call, deny",
    "p, codebuddy, ^(169\\.254\\.169\\.254|metadata\\.google\\.internal)$, .*, deny",
    "p, codebuddy, ^(.+\\.)?(pastebin\\.com|paste\\.ee|0x0\\.st|transfer\\.sh|file\\.io|gofile\\.io)$, .*, deny",
    "p, codebuddy, ^(.+\\.)?(ngrok\\.io|ngrok-free\\.app|trycloudflare\\.com|serveo\\.net|localtunnel\\.me)$, .*, deny",
    "",
    "# 8. A coding agent never moves money.",
    "p, codebuddy, .*, payment, deny"
  ],
  "request": [
    "codebuddy, api.codebuddy.ai, llm.chat",
    "codebuddy, api.openai.com, llm.chat",
    "codebuddy, mcp.context7.com#get-library-docs, mcp.tool_call",
    "codebuddy, 127.0.0.1:3000#read_file, mcp.tool_call",
    "codebuddy, 127.0.0.1:3000#edit_file, mcp.tool_call",
    "codebuddy, 127.0.0.1:3000#git_commit, mcp.tool_call",
    "codebuddy, 127.0.0.1:3000#git_push, mcp.tool_call",
    "codebuddy, 127.0.0.1:3000#brew_search, mcp.tool_call",
    "codebuddy, 127.0.0.1:3000#applescript_execute, mcp.tool_call",
    "codebuddy, 127.0.0.1:3000#read_env_file, mcp.tool_call",
    "codebuddy, files.pastebin.com, llm.chat",
    "codebuddy, api.stripe.com, payment",
    "# Another agent's call matches no rule here - one set speaks for one agent.",
    "some-other-agent, api.codebuddy.ai, llm.chat"
  ]
}
