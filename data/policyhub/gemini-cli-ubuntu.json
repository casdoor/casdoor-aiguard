{
  "displayName": "Gemini CLI on Ubuntu",
  "description": "Everything Gemini CLI does on Ubuntu while you code, decided by one policy. Only Google's Gemini and sign-in endpoints count as model endpoints, so a prompt containing your code cannot end up at a provider you never chose. Local MCP servers may read, edit and commit your working tree, while pushes, deletions and shell execution stop and wait for you. Apt, snap and systemd stay off limits, and so do secrets, cloud metadata, paste and tunnelling sites, and every payment.",
  "icon": "🐧",
  "author": "Casdoor",
  "strictness": "moderate",
  "agent": "Gemini CLI",
  "os": "Ubuntu",
  "tags": [
    "coding",
    "llm-egress",
    "mcp-tools",
    "apt"
  ],
  "model": [
    "[request_definition]",
    "r = sub, obj, act",
    "",
    "[policy_definition]",
    "p = sub, obj, act, eft",
    "",
    "[policy_effect]",
    "e = some(where (p_eft == allow)) && !some(where (p_eft == deny))",
    "",
    "[matchers]",
    "m = r.sub == p.sub && regexMatch(r.obj, p.obj) && regexMatch(r.act, p.act)"
  ],
  "policy": [
    "# aiguard evaluates one triple per intercepted call:",
    "#   sub = the recognized agent, obj = the destination host (\"host#tool\" for",
    "#   an MCP tools/call), act = the intent category the recognizer produced.",
    "",
    "# 1. The model endpoints Gemini CLI is allowed to talk to.",
    "p, gemini-cli, ^(generativelanguage|cloudcode-pa|oauth2)\\.googleapis\\.com$, llm\\.chat, allow",
    "",
    "# 2. Documentation MCP servers it may query over the network.",
    "p, gemini-cli, ^(mcp\\.context7\\.com|mcp\\.deepwiki\\.com)#.*$, mcp\\.tool_call, allow",
    "",
    "# 3. Local MCP servers: it may read, edit and commit inside the repository it was started in.",
    "p, gemini-cli, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(read_file|read_text_file|read_multiple_files|list_directory|directory_tree|search_files|get_file_info|grep_search)$, mcp\\.tool_call, allow",
    "p, gemini-cli, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(write_file|edit_file|create_file|apply_patch|create_directory|move_file)$, mcp\\.tool_call, allow",
    "p, gemini-cli, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#git_(status|diff|log|show|branch|blame)$, mcp\\.tool_call, allow",
    "p, gemini-cli, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#git_(add|commit|checkout|stash)$, mcp\\.tool_call, allow",
    "p, gemini-cli, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(run_tests|build_project|lint_project|format_file)$, mcp\\.tool_call, allow",
    "",
    "# 4. Read-only apt queries are part of debugging a build.",
    "p, gemini-cli, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(apt_list|apt_search|apt_show|snap_find)$, mcp\\.tool_call, allow",
    "",
    "# 5. Changing the machine itself is not coding: apt, snap and systemd.",
    "p, gemini-cli, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(apt_install|apt_remove|snap_install|systemctl_(start|stop|enable)|ufw_disable)$, mcp\\.tool_call, deny",
    "p, gemini-cli, .*#(execute_command|run_command|run_shell|start_process|kill_process|create_process)$, mcp\\.tool_call, deny",
    "",
    "# 6. Destructive or outward-facing repository operations need a human.",
    "p, gemini-cli, .*#(delete_file|remove_directory|delete_directory|git_push|git_reset_hard|git_clean|git_force_push)$, mcp\\.tool_call, deny",
    "",
    "# 7. Secrets, cloud metadata and the usual exfiltration channels.",
    "p, gemini-cli, .*#.*(secret|credential|token|password|api_key|keychain|env_file).*$, mcp\\.tool_call, deny",
    "p, gemini-cli, ^(169\\.254\\.169\\.254|metadata\\.google\\.internal)$, .*, deny",
    "p, gemini-cli, ^(.+\\.)?(pastebin\\.com|paste\\.ee|0x0\\.st|transfer\\.sh|file\\.io|gofile\\.io)$, .*, deny",
    "p, gemini-cli, ^(.+\\.)?(ngrok\\.io|ngrok-free\\.app|trycloudflare\\.com|serveo\\.net|localtunnel\\.me)$, .*, deny",
    "",
    "# 8. A coding agent never moves money.",
    "p, gemini-cli, .*, payment, deny"
  ],
  "request": [
    "gemini-cli, generativelanguage.googleapis.com, llm.chat",
    "gemini-cli, api.openai.com, llm.chat",
    "gemini-cli, mcp.context7.com#get-library-docs, mcp.tool_call",
    "gemini-cli, 127.0.0.1:3000#read_file, mcp.tool_call",
    "gemini-cli, 127.0.0.1:3000#edit_file, mcp.tool_call",
    "gemini-cli, 127.0.0.1:3000#git_commit, mcp.tool_call",
    "gemini-cli, 127.0.0.1:3000#git_push, mcp.tool_call",
    "gemini-cli, 127.0.0.1:3000#apt_search, mcp.tool_call",
    "gemini-cli, 127.0.0.1:3000#apt_install, mcp.tool_call",
    "gemini-cli, 127.0.0.1:3000#read_env_file, mcp.tool_call",
    "gemini-cli, files.pastebin.com, llm.chat",
    "gemini-cli, api.stripe.com, payment",
    "# Another agent's call matches no rule here - one set speaks for one agent.",
    "some-other-agent, generativelanguage.googleapis.com, llm.chat"
  ]
}
