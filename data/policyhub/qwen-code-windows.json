{
  "displayName": "Qwen Code on Windows",
  "description": "Everything Qwen Code does on Windows while you code, decided by one policy. Only DashScope and the Qwen endpoints count as model endpoints, so a prompt containing your code cannot end up at a provider you never chose. Local MCP servers may read, edit and commit your working tree, while pushes, deletions and shell execution stop and wait for you. PowerShell, the registry and the Windows scheduler stay off limits, and so do secrets, cloud metadata, paste and tunnelling sites, and every payment.",
  "icon": "🪟",
  "author": "Casdoor",
  "strictness": "moderate",
  "agent": "Qwen Code",
  "os": "Windows",
  "tags": [
    "coding",
    "llm-egress",
    "mcp-tools",
    "winget"
  ],
  "model": [
    "[request_definition]",
    "r = sub, obj, act",
    "",
    "[policy_definition]",
    "p = sub, obj, act, eft",
    "",
    "[policy_effect]",
    "e = some(where (p_eft == allow)) && !some(where (p_eft == deny))",
    "",
    "[matchers]",
    "m = r.sub == p.sub && regexMatch(r.obj, p.obj) && regexMatch(r.act, p.act)"
  ],
  "policy": [
    "# aiguard evaluates one triple per intercepted call:",
    "#   sub = the recognized agent, obj = the destination host (\"host#tool\" for",
    "#   an MCP tools/call), act = the intent category the recognizer produced.",
    "",
    "# 1. The model endpoints Qwen Code is allowed to talk to.",
    "p, qwen-code, ^(.+\\.)?dashscope\\.aliyuncs\\.com$, llm\\.chat, allow",
    "p, qwen-code, ^(.+\\.)?qwen\\.ai$, llm\\.chat, allow",
    "p, qwen-code, ^(.+\\.)?modelscope\\.cn$, llm\\.chat, allow",
    "",
    "# 2. Documentation MCP servers it may query over the network.",
    "p, qwen-code, ^(mcp\\.context7\\.com|mcp\\.deepwiki\\.com)#.*$, mcp\\.tool_call, allow",
    "",
    "# 3. Local MCP servers: it may read, edit and commit inside the repository it was started in.",
    "p, qwen-code, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(read_file|read_text_file|read_multiple_files|list_directory|directory_tree|search_files|get_file_info|grep_search)$, mcp\\.tool_call, allow",
    "p, qwen-code, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(write_file|edit_file|create_file|apply_patch|create_directory|move_file)$, mcp\\.tool_call, allow",
    "p, qwen-code, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#git_(status|diff|log|show|branch|blame)$, mcp\\.tool_call, allow",
    "p, qwen-code, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#git_(add|commit|checkout|stash)$, mcp\\.tool_call, allow",
    "p, qwen-code, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(run_tests|build_project|lint_project|format_file)$, mcp\\.tool_call, allow",
    "",
    "# 4. Read-only winget queries are part of debugging a build.",
    "p, qwen-code, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(winget_search|winget_list|choco_search|choco_list|systeminfo)$, mcp\\.tool_call, allow",
    "",
    "# 5. Changing the machine itself is not coding: PowerShell, the registry and the Windows scheduler.",
    "p, qwen-code, ^(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?#(powershell_exec|cmd_exec|registry_write|registry_delete|schtasks_create|sc_config|winget_install|choco_install)$, mcp\\.tool_call, deny",
    "p, qwen-code, .*#(execute_command|run_command|run_shell|start_process|kill_process|create_process)$, mcp\\.tool_call, deny",
    "",
    "# 6. Destructive or outward-facing repository operations need a human.",
    "p, qwen-code, .*#(delete_file|remove_directory|delete_directory|git_push|git_reset_hard|git_clean|git_force_push)$, mcp\\.tool_call, deny",
    "",
    "# 7. Secrets, cloud metadata and the usual exfiltration channels.",
    "p, qwen-code, .*#.*(secret|credential|token|password|api_key|keychain|env_file).*$, mcp\\.tool_call, deny",
    "p, qwen-code, ^(169\\.254\\.169\\.254|metadata\\.google\\.internal)$, .*, deny",
    "p, qwen-code, ^(.+\\.)?(pastebin\\.com|paste\\.ee|0x0\\.st|transfer\\.sh|file\\.io|gofile\\.io)$, .*, deny",
    "p, qwen-code, ^(.+\\.)?(ngrok\\.io|ngrok-free\\.app|trycloudflare\\.com|serveo\\.net|localtunnel\\.me)$, .*, deny",
    "",
    "# 8. A coding agent never moves money.",
    "p, qwen-code, .*, payment, deny"
  ],
  "request": [
    "qwen-code, dashscope.aliyuncs.com, llm.chat",
    "qwen-code, api.openai.com, llm.chat",
    "qwen-code, mcp.context7.com#get-library-docs, mcp.tool_call",
    "qwen-code, 127.0.0.1:3000#read_file, mcp.tool_call",
    "qwen-code, 127.0.0.1:3000#edit_file, mcp.tool_call",
    "qwen-code, 127.0.0.1:3000#git_commit, mcp.tool_call",
    "qwen-code, 127.0.0.1:3000#git_push, mcp.tool_call",
    "qwen-code, 127.0.0.1:3000#winget_search, mcp.tool_call",
    "qwen-code, 127.0.0.1:3000#powershell_exec, mcp.tool_call",
    "qwen-code, 127.0.0.1:3000#read_env_file, mcp.tool_call",
    "qwen-code, files.pastebin.com, llm.chat",
    "qwen-code, api.stripe.com, payment",
    "# Another agent's call matches no rule here - one set speaks for one agent.",
    "some-other-agent, dashscope.aliyuncs.com, llm.chat"
  ]
}
